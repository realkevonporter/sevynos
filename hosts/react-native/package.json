{
  "name": "@sevynos/react-native-host",
  "version": "0.1.0",
  "private": true,
  "description": "The SevynOS host adapter for mounted React Native applications.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@sevynos/react-native": "workspace:*",
    "@sevynos/runtime": "workspace:*",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "^19.2.8"
  }
}
