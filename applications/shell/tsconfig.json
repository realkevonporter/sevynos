{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist",
    "composite": true,
    "tsBuildInfoFile": "dist/system-applications.tsbuildinfo",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": ["react"]
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "references": [
    {
      "path": "../../shell/core"
    }
  ],
  "exclude": ["dist", "node_modules"]
}
