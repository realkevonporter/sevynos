{
  "name": "@sevynos/desktop-shell",
  "version": "0.1.0",
  "private": true,
  "description": "The host-independent SevynOS desktop environment and scene composition layer.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal.d.ts",
      "import": "./dist/internal.js"
    },
    "./shell-component-registry": {
      "types": "./dist/shell-component-registry.d.ts",
      "import": "./dist/shell-component-registry.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "clean": "rm -rf dist coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@sevynos/accounts": "workspace:*",
    "@sevynos/app-browser": "workspace:*",
    "@sevynos/app-calculator": "workspace:*",
    "@sevynos/app-camera": "workspace:*",
    "@sevynos/app-files": "workspace:*",
    "@sevynos/app-music": "workspace:*",
    "@sevynos/app-settings": "workspace:*",
    "@sevynos/app-store": "workspace:*",
    "@sevynos/app-system-monitor": "workspace:*",
    "@sevynos/app-terminal": "workspace:*",
    "@sevynos/app-text-editor": "workspace:*",
    "@sevynos/app-welcome": "workspace:*",
    "@sevynos/app-setup-wizard": "workspace:*",
    "@sevynos/core-applications": "workspace:*",
    "@sevynos/file-archives": "workspace:*",
    "@sevynos/app-notes": "workspace:*",
    "@sevynos/graphics": "workspace:*",
    "@sevynos/input": "workspace:*",
    "@sevynos/os-update": "workspace:*",
    "@sevynos/react-native": "workspace:*",
    "@sevynos/runtime": "workspace:*",
    "@sevynos/shell-core": "workspace:*",
    "@sevynos/system-applications": "workspace:*",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
