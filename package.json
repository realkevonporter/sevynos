{
  "name": "sevynos",
  "version": "0.1.0",
  "private": true,
  "description": "An open operating system that belongs to its users.",
  "homepage": "https://sevynos.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/realkevonporter/sevynos.git"
  },
  "bugs": {
    "url": "https://github.com/realkevonporter/sevynos/issues"
  },
  "license": "Apache-2.0",
  "packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "start": "pnpm --filter @sevynos/demo start",
    "clean": "node tools/repository/clean.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:repository && turbo run test",
    "test:repository": "node --test tools/repository/*.test.mjs tools/qemu/*.test.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "sevyn": "node tools/cli/dist/cli.js",
    "desktop": "pnpm --filter @sevynos/desktop-host start",
    "desktop:dev": "pnpm --filter @sevynos/desktop-host dev",
    "desktop:build": "pnpm --filter @sevynos/desktop-host build:workspace:prod",
    "desktop:package": "pnpm --filter @sevynos/desktop-host package",
    "desktop:package:mac": "pnpm --filter @sevynos/desktop-host package:mac",
    "desktop:package:linux": "pnpm --filter @sevynos/desktop-host package:linux",
    "linux:headless": "pnpm --filter @sevynos/linux-host start",
    "linux:wayland": "pnpm --filter @sevynos/linux-host wayland",
    "linux:build": "pnpm --filter @sevynos/linux-host build:workspace",
    "linux:native:build": "pnpm --filter @sevynos/linux-host native:build",
    "qemu:build": "pnpm desktop:build && pnpm linux:build && node tools/qemu/build.mjs",
    "qemu:run": "node tools/qemu/run.mjs",
    "qemu:display:test": "node --test tools/qemu/display-configuration.test.mjs",
    "qemu:headless": "node tools/qemu/headless.mjs",
    "qemu:input:test": "node tools/qemu/input-test.mjs",
    "qemu:focus:test": "node tools/qemu/focus-latency-test.mjs",
    "qemu:stop": "node tools/qemu/stop.mjs",
    "qemu:clean": "node tools/qemu/clean.mjs",
    "qemu:smoke": "node tools/qemu/smoke.mjs",
    "qemu:install:test": "node tools/qemu/install-smoke.mjs",
    "qemu:install:uefi:test": "SEVYN_QEMU_FIRMWARE=uefi node tools/qemu/install-smoke.mjs",
    "usb:build": "pnpm qemu:build",
    "usb:run": "node tools/qemu/usb-run.mjs",
    "usb:smoke": "node tools/qemu/usb-smoke.mjs",
    "usb:uefi:smoke": "SEVYN_QEMU_FIRMWARE=uefi node tools/qemu/usb-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
